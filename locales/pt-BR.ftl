# Português brasileiro (pt-BR) — sugestões humanas apenas.
# JSON de máquina (`error.message`) e tracing permanecem em inglês (contrato de agente).
# Chaves alinhadas com `UiMessage` em src/i18n/ui_message.rs. Acentuação NFC obrigatória.

usage-suggestion = Confira --help e os argumentos obrigatórios
broken-pipe-suggestion = Não pipe stdout para consumidor fechado; exit 141 é esperado
unavailable-suggestion = Instale Chrome/Chromium no PATH ou use: browser-automation-cli config set chrome_path <path>
data-suggestion = Verifique robots.txt ou o payload JSON/NDJSON
browser-suggestion = Verifique URL e se o Chrome ainda está vivo no one-shot
vision-required = Passe --experimental-vision na mesma invocação
robots-dual = Passe as duas flags juntas quando ignorar robots.txt de propósito
category-memory = Passe --category-memory (heap take/summary/close funcionam sem ops de grafo profundo)
category-extensions = Passe --category-extensions na mesma invocação
screencast-flag = Passe --experimental-screencast na mesma invocação
webmcp-flag = Passe --category-webmcp na mesma invocação
third-party-flag = Passe --category-third-party na mesma invocação
capture-network = Passe --capture-network antes de run/net
capture-console = Passe --capture-console antes de run/console
run-fail-fast = Corrija o passo com falha; os passos seguintes não foram executados
lighthouse-missing = Instale lighthouse ou: browser-automation-cli config set lighthouse_path <path>
lighthouse-timeout = Aumente o timeout: browser-automation-cli config set lighthouse_timeout_secs <segundos>
ffmpeg-timeout = Aumente o timeout: browser-automation-cli config set ffmpeg_timeout_secs <segundos>
binary-unsafe-windows = Use caminho de binário nativo (não .bat/.cmd/.ps1): config set lighthouse_path|ffmpeg_path <exe>
ssrf-blocked = Use uma URL http(s) pública, ou: config set http_ssrf_mode allow_loopback|off
http-body-too-large = Aumente scrape_max_body_bytes via config set, ou baixe um recurso menor
http-connect-timeout = Aumente o timeout de connect: config set http_connect_timeout_secs <segundos>
redis-host-blocked = Use redis://127.0.0.1:6379 ou: config set redis_allow_remote true
locale-resolved = Locale de UI resolvido
locale-source = Fonte da resolução
url-absolute-http = Passe uma URL http(s) absoluta com host (about:blank e file:// só onde documentado)
target-ref-from-view = Use um seletor CSS ou uma ref @eN de view no mesmo processo
navigate-first = Navegue com goto antes no mesmo processo, ou permita página em branco explicitamente
json-array-objects = Passe um array JSON de objetos, ou NDJSON com um objeto por linha
json-object-payload = Passe um payload JSON de objeto único
raise-size-limit = Aumente o teto de bytes via config set, ou use uma entrada menor
raise-timeout = Aumente --timeout ou --step-timeout, ou reduza o trabalho por passo
external-binary-path = Instale o binário ou defina um caminho executável absoluto via config set
llm-config-required = Defina os knobs de LLM: config set openrouter_api_key|llm_base_url|llm_model
redis-config-required = Suba o redis-server e defina cache_redis_url, ou: config set cache_backend sqlite
config-list-keys = Execute: browser-automation-cli config list-keys
use-listed-value = Use um dos valores suportados informados na mensagem
file-path-invalid = Passe um caminho de arquivo regular existente (não um diretório)
heap-snapshot-input = Passe um caminho produzido por heap take (.heapsnapshot JSON) com node ou class id válido
extension-unpacked-dir = Passe um diretório de extensão descompactada contendo manifest.json
extension-list-first = Rode extension list antes e passe um id de extensão carregada
run-script-multi-step = Use run --script NDJSON para que passos dependentes dividam um processo
cdp-key-name = Passe um nome de tecla CDP como Enter, Tab, Escape ou ArrowDown
dialog-open-required = Dispare o diálogo antes com um press que abra alert/confirm/prompt
console-assert-threshold = Corrija o ruído de console da página ou aumente o limite do assert
retry-after-cancel = Rode o comando de novo; a invocação anterior foi interrompida (exit 130)
workflow-cycle = Remova arestas depends_on circulares do manifesto
chrome-search-paths-format = Liste caminhos de descoberta separados pelo separador de caminho da plataforma
webhook-unreachable = Verifique se --webhook-url está acessível; destino é do operador
qr-image-quality = Use um PNG/JPEG nítido de QR code com zona de silêncio
pdf-input-invalid = Forneça um arquivo PDF real; gere um com print-pdf se precisar
sheet-input-format = Passe um arquivo .csv, .tsv ou .json com um array de objetos
viewport-spec-format = Formato: WxHxDPR[,mobile][,touch][,landscape]
commands-discovery = Execute: browser-automation-cli commands --json para listar a superfície viva
schema-command-required = Use: browser-automation-cli schema <cmd> ou schema --cmd <cmd>
scrape-engine-choice = Use --engine http para baseline one-shot, ou --engine browser / parse para arquivos locais
chrome-launch-failed = Verifique a instalação do Chrome e a disponibilidade de Xvfb em launches headed no Linux
step-field-unknown = Confira os campos permitidos para este cmd de passo em schema run
xdg-home-required = Garanta que o diretório home esteja disponível para este usuário
heap-capture-failed = Garanta que o Chrome exponha HeapProfiler; rode doctor de novo e cheque os forwarders de evento
path-outside-roots = Mantenha o caminho sob uma raiz permitida, acrescente uma com config set allowed_roots, ou passe --allow-outside-roots
mitm-capture-path = Passe --capture-path <arquivo> para ler uma captura escrita por outra invocação
drag-same-frame = Arraste dentro de um único frame, ou dirija o iframe como alvo próprio
drag-destination-required = Passe --to @eN / CSS, ou --to-x N --to-y N
submit-needs-form = Passe o próprio <form> ou qualquer campo dentro dele
submit-validation-failed = Preencha os campos obrigatórios, ou afrouxe a validação do formulário antes de enviar
include-cycle = Remova o include que aponta de volta para um script ja incluido
include-depth = Achate o script ou reduza o aninhamento de includes
include-path-required = Use {"{"}"cmd":"include","path":"outro.jsonl"{"}"}
assert-step-path = Use {"{"}"cmd":"assert","kind":"step","path":"result","equals":"OK"{"}"}
assert-step-order = Coloque o assert depois do passo cujo payload ele verifica
assert-step-operator = Use um entre equals, contains ou exists
assert-step-inspect = Inspecione o payload do passo anterior com --json-steps e ajuste path/expected
