# English (neutral `en`) — human-facing suggestions only.
# Machine JSON `error.message` and tracing stay English and are not FTL keys.
# Identifiers are English; keep keys in sync with `UiMessage` in src/i18n/ui_message.rs.

usage-suggestion = Check --help and required arguments
broken-pipe-suggestion = Do not pipe stdout to a closed consumer; exit 141 is expected
unavailable-suggestion = Install Chrome/Chromium on PATH or: browser-automation-cli config set chrome_path <path>
data-suggestion = Check robots.txt or the JSON/NDJSON payload
browser-suggestion = Check the URL and whether Chrome stayed alive in this one-shot
vision-required = Pass --experimental-vision on the same invocation
robots-dual = Pass both flags together when you intentionally skip robots.txt
category-memory = Pass --category-memory (heap take/summary/close work without deep graph ops)
category-extensions = Pass --category-extensions on the same invocation
screencast-flag = Pass --experimental-screencast on the same invocation
webmcp-flag = Pass --category-webmcp on the same invocation
third-party-flag = Pass --category-third-party on the same invocation
capture-network = Pass --capture-network before run/net
capture-console = Pass --capture-console before run/console
run-fail-fast = Fix the failing step; subsequent steps were not executed
lighthouse-missing = Install lighthouse or: browser-automation-cli config set lighthouse_path <path>
lighthouse-timeout = Increase timeout: browser-automation-cli config set lighthouse_timeout_secs <seconds>
ffmpeg-timeout = Increase timeout: browser-automation-cli config set ffmpeg_timeout_secs <seconds>
binary-unsafe-windows = Use a native binary path (not .bat/.cmd/.ps1): config set lighthouse_path|ffmpeg_path <exe>
perf-trace-path = Pass a trace file written by `perf stop --path`
vision-coordinates = Coordinates are page CSS pixels; pass --experimental-vision on the same invocation
eval-args-uids = Pass a JSON array of refs to --args, for example ["@e1","@e2"]
extract-llm-usage = Example: extract --llm --question 'sum' https://example.com
mitm-block-target = Name a target, for example: mitm block --host example.com
devtools3p-list-first = Run devtools3p list --url <page> with --category-third-party to see the tool names
webmcp-input-json = Pass a JSON object to --input, with the tool input as key/value pairs
devtools3p-params-json = Pass a JSON object to --params, with the tool parameters as key/value pairs
run-script-file = Pass an existing NDJSON/JSONL or JSON-array file to --script
init-script-javascript = Pass valid JavaScript to --init-script
raise-step-timeout = Raise --step-timeout or --timeout, or split the script into fewer steps
workflow-run-first = Run workflow run first, or point at an existing journal with --journal
cookie-json-example = Pass the cookie array to --cookies-json; the global --json only selects the envelope format
goto-run-script = Use run --script steps.jsonl so goto and reload --init-script share one process
console-capture-run = Pass --capture-console on the same invocation, for example: --capture-console run --script audit.jsonl
page-select-target = Pass an index or --page-id, for example: page select 0
blocked-by-waf = A bot check answered instead of the page; see data.block_detection. Retrying escalates toward a ban: use --engine browser, change egress with --proxy, or wait
ssrf-blocked = Use a public http(s) URL, or: config set http_ssrf_mode allow_loopback|off
http-body-too-large = Raise scrape_max_body_bytes via config set, or fetch a smaller resource
http-connect-timeout = Raise connect timeout: config set http_connect_timeout_secs <seconds>
redis-host-blocked = Use redis://127.0.0.1:6379 or: config set redis_allow_remote true
proxy-url-invalid = Use http://, https://, socks5:// or socks5h:// with host and port
locale-resolved = Resolved UI locale
locale-source = Resolution source
url-absolute-http = Pass an absolute http(s) URL with a host (about:blank and file:// only where documented)
target-ref-from-view = Use a CSS selector or an @eN ref from view in the same process
navigate-first = Navigate with goto first in the same process, or allow a blank page explicitly
json-array-objects = Pass a JSON array of objects, or NDJSON with one object per line
json-object-payload = Pass a single JSON object payload
raise-size-limit = Raise the byte ceiling via config set, or use a smaller input
raise-timeout = Raise --timeout or --step-timeout, or reduce the work per step
agent-ops-filter-syntax = Use key=value, key!=value or key~substring (dotted paths allowed)
agent-ops-no-rows = This command has no list; use --fields to project fields instead
agent-ops-many-rows = Narrow to one list with --fields <key>, then filter/sort/limit it
agent-ops-over-budget = Raise --max-output-bytes, or narrow the payload with --fields
urls-file-too-large = Split the list, or raise it with: config set max_urls_file_bytes <n>
external-binary-path = Install the binary or set an absolute executable path via config set
llm-config-required = Set the LLM knobs: config set openrouter_api_key|llm_base_url|llm_model
redis-config-required = Start redis-server and set cache_redis_url, or: config set cache_backend sqlite
config-list-keys = Run: browser-automation-cli config list-keys
config-bool-value = Use true|false|1|0|yes|no|on|off (case-insensitive); config unset <key> restores the default
use-listed-value = Use one of the supported values reported in the message
file-path-invalid = Pass an existing regular file path (not a directory)
heap-snapshot-input = Pass a path produced by heap take (.heapsnapshot JSON) with a valid node or class id
extension-unpacked-dir = Pass an unpacked extension directory containing manifest.json
extension-list-first = Run extension list first and pass an id from a loaded extension
run-script-multi-step = Use run --script NDJSON so dependent steps share one process
cdp-key-name = Pass a CDP key name such as Enter, Tab, Escape, or ArrowDown
dialog-open-required = Trigger the dialog first with a press that opens alert/confirm/prompt
console-assert-threshold = Fix the page console noise or raise the assert threshold
retry-after-cancel = Re-run the command; the previous invocation was interrupted (exit 130)
workflow-cycle = Remove circular depends_on edges from the manifest
chrome-search-paths-format = List discovery paths separated by the platform path separator
webhook-unreachable = Check --webhook-url reachability; operator destination only
qr-image-quality = Use a clear PNG/JPEG of a QR code with a quiet zone
pdf-input-invalid = Provide a real PDF file; generate one with print-pdf if needed
sheet-input-format = Pass a .csv, .tsv, or .json file holding an array of objects
viewport-spec-format = Format: WxHxDPR[,mobile][,touch][,landscape]
commands-discovery = Run: browser-automation-cli commands --json to list the live surface
schema-command-required = Use: browser-automation-cli schema <cmd> or schema --cmd <cmd>
scrape-engine-choice = Use --engine http for one-shot baselines, or --engine browser / parse for local files
scrape-opaque-content = Download the file first, then read it with parse; or use image / video / audio for that media type
chrome-launch-failed = Check the Chrome install and Xvfb availability on Linux headed launches
step-field-unknown = Check the allowed fields for this step cmd in schema run
xdg-home-required = Ensure the home directory is available for this user
heap-capture-failed = Ensure Chrome exposes HeapProfiler; re-run doctor and check event forwarders
path-is-process-substitution = Read the steps from stdin with run --script - instead: shell process substitution exposes the file as /proc/<pid>/fd/<n>, which no allowed root can contain
path-outside-roots = Keep the path under an allowed root, add one with config set allowed_roots, or pass --allow-outside-roots
mitm-capture-path = Pass --capture-path <file> to read a capture written by another invocation
drag-same-frame = Drag within one frame, or drive the iframe as its own target
drag-destination-required = Pass --to @eN / CSS, or --to-x N --to-y N
submit-needs-form = Pass the <form> itself or any field inside it
submit-validation-failed = Fill the required fields, or relax the form validation before submitting
include-cycle = Remove the include that points back into an already-included script
include-depth = Flatten the script or reduce include nesting
include-path-required = Use {"{"}"cmd":"include","path":"other.jsonl"{"}"}
assert-step-path = Use {"{"}"cmd":"assert","kind":"step","path":"result","equals":"OK"{"}"}
assert-step-order = Place the assert after the step whose payload it checks
assert-step-operator = Use one of equals, contains or exists
assert-step-inspect = Inspect the previous step payload with --json-steps and adjust path/expected
image-too-large = Raise image_max_input_bytes or image_max_pixels via config set, or use a smaller image
image-feature-disabled = Rebuild with the required Cargo feature (image-avif, image-heic, image-svg or media-manifest)
image-heic-encode-unavailable = Encode to png, jpeg, webp, gif or avif; no pure-Rust HEVC encoder exists, so HEIC is decode-only
svg-rejected = Remove the DOCTYPE, script, event handler or external href, or raise svg_max_entities / svg_max_depth via config set
video-too-large = Raise video_max_input_bytes via config set, or use a smaller file
video-site-extraction-rejected = Pass the direct media URL; extracting streams from site players is rejected by rule, not deferred
video-manifest-not-a-file = Parse the manifest to pick a variant, then download that variant's direct URL
video-magic-invalid = Pass a real video file (mp4/webm/mkv/…); magic bytes are checked, not the extension
video-format-unsupported = Use mp4, webm, mkv, mov, avi, or m4v as --format
video-codec-container-mismatch = Pick codecs allowed for the output container (e.g. WebM: vp9+opus; no H.264 in WebM)
ffmpeg-failed = Check codecs/container, raise ffmpeg_timeout_secs, or pass explicit --video-codec/--audio-codec
ffmpeg-io-failed = Ensure input is readable and output path is writable (parent dir exists; not read-only); check permissions
ffmpeg-missing = Install ffmpeg/ffprobe and: config set ffmpeg_path <absolute-path>
image-magic-invalid = Pass a real image file (png/jpeg/webp/gif); magic bytes are checked, not the extension
image-format-unsupported = Use png, jpeg, webp or gif; AVIF is encode-only and HEIC/SVG need their Cargo feature
audio-too-large = Raise audio_max_input_bytes via config set, or use a smaller file
audio-magic-invalid = Pass a real audio file (mp3/wav/flac/ogg/m4a/…); magic bytes are checked, not the extension
audio-format-unsupported = Use mp3, m4a, aac, ogg, opus, flac, or wav as --format
audio-lossy-transcode = Lossy→lossy recompress degrades quality; prefer lossless source or stream copy when possible
http-status-scrape = HTTP error page is not scraped as success; check status_code or use batch with --filter http_error=false
meta-robots-noindex = Page declares noindex (meta or X-Robots-Tag); honor robots or set scrape_honor_meta_robots=false intentionally
