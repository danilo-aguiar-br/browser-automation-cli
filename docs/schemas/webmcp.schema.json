{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/danilo-aguiar-br/browser-automation-cli/docs/schemas/webmcp.schema.json",
  "title": "webmcp command input",
  "type": "object",
  "description": "Web surface tools (requires --category-webmcp)",
  "properties": {
    "action": {
      "actions": {
        "exec": {
          "description": "Execute one WebMCP tool by name",
          "properties": {
            "input": {
              "argv": "--input",
              "description": "JSON input passed to the tool",
              "required": false,
              "source": "parser",
              "step_key": "input",
              "surfaces": [
                "argv",
                "run_step",
                "exec"
              ],
              "type": "string"
            },
            "name": {
              "argv": "<NAME>",
              "description": "Tool name from `webmcp list`",
              "required": true,
              "source": "parser",
              "step_key": "name",
              "surfaces": [
                "argv",
                "run_step",
                "exec"
              ],
              "type": "string"
            },
            "url": {
              "argv": "--url",
              "description": "Page URL to open before executing",
              "required": false,
              "source": "parser",
              "step_key": "url",
              "surfaces": [
                "argv",
                "run_step",
                "exec"
              ],
              "type": "string"
            }
          }
        },
        "list": {
          "description": "List WebMCP tools exposed by the page",
          "properties": {
            "url": {
              "argv": "--url",
              "description": "Page URL to open before discovery",
              "required": false,
              "source": "parser",
              "step_key": "url",
              "surfaces": [
                "argv",
                "run_step",
                "exec"
              ],
              "type": "string"
            }
          }
        }
      },
      "argv": "<ACTION>",
      "description": "Subcommand action word",
      "enum": [
        "list",
        "exec"
      ],
      "required": true,
      "source": "parser",
      "step_key": "action",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "string"
    },
    "input": {
      "source": "catalog",
      "step_key": "input",
      "surfaces": [
        "run_step",
        "exec"
      ],
      "type": "string"
    },
    "name": {
      "source": "catalog",
      "step_key": "name",
      "surfaces": [
        "run_step",
        "exec"
      ],
      "type": "string"
    },
    "url": {
      "source": "catalog",
      "step_key": "url",
      "surfaces": [
        "run_step",
        "exec"
      ],
      "type": "string"
    }
  },
  "required": [
    "action"
  ],
  "additionalProperties": false
}