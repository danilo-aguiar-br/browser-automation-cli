{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/danilo-aguiar-br/browser-automation-cli/docs/schemas/scrape.schema.json",
  "title": "scrape command input",
  "type": "object",
  "description": "Navigate and return body text / formats (local HTTP or CDP scrape)",
  "properties": {
    "engine": {
      "argv": "--engine",
      "default": "browser",
      "description": "http (reqwest+scraper) or browser (CDP)",
      "required": false,
      "source": "parser",
      "step_key": "engine",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "string"
    },
    "format": {
      "argv": "--format",
      "default": "text",
      "description": "text | markdown | html | links | metadata | … (CSV or repeatable; alias --formats)",
      "items": {
        "type": "string"
      },
      "required": false,
      "source": "parser",
      "step_key": "format",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "array"
    },
    "formats": {
      "description": "Alias of format for multi-value (GAP-018)",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      ],
      "source": "catalog",
      "step_key": "formats",
      "surfaces": [
        "run_step",
        "exec"
      ]
    },
    "only_main_content": {
      "argv": "--only-main-content",
      "description": "Prefer main/article content heuristics",
      "required": false,
      "source": "parser",
      "step_key": "only_main_content",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "boolean"
    },
    "url": {
      "argv": "<URL>",
      "description": "Absolute URL to fetch",
      "required": true,
      "source": "parser",
      "step_key": "url",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "string"
    },
    "webhook_url": {
      "argv": "--webhook-url",
      "description": "Optional one-shot webhook POST of the result envelope data (127.0.0.1/operator URL)",
      "required": false,
      "source": "parser",
      "step_key": "webhook_url",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "string"
    }
  },
  "required": [
    "url"
  ],
  "additionalProperties": false
}