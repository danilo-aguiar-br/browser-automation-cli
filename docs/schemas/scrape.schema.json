{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/danilo-aguiar-br/browser-automation-cli/docs/schemas/scrape.schema.json",
  "title": "scrape command input",
  "type": "object",
  "description": "Navigate and return body text / formats (local HTTP or CDP scrape)",
  "properties": {
    "action": {
      "argv": "--action",
      "description": "Act on the page before scraping it: one `run --script` step as JSON (repeatable)",
      "items": {
        "type": "string"
      },
      "required": false,
      "source": "parser",
      "step_key": "action",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "array"
    },
    "attribute_name": {
      "argv": "--attribute-name",
      "description": "Attribute to read from the matching selector, for `--format attributes` (repeatable)",
      "items": {
        "type": "string"
      },
      "required": false,
      "source": "parser",
      "step_key": "attribute_name",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "array"
    },
    "attribute_selector": {
      "argv": "--attribute-selector",
      "description": "CSS selector to read an attribute from, for `--format attributes` (repeatable)",
      "items": {
        "type": "string"
      },
      "required": false,
      "source": "parser",
      "step_key": "attribute_selector",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "array"
    },
    "engine": {
      "argv": "--engine",
      "default": "http",
      "description": "http (reqwest+scraper) or browser (CDP); default XDG scrape_default_engine (http)",
      "required": false,
      "source": "parser",
      "step_key": "engine",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "string"
    },
    "exclude_selector": {
      "argv": "--exclude-selector",
      "description": "CSS selectors to exclude (repeatable)",
      "items": {
        "type": "string"
      },
      "required": false,
      "source": "parser",
      "step_key": "exclude_selector",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "array"
    },
    "format": {
      "argv": "--format",
      "default": "text",
      "description": "text | markdown | html | rawHtml | links | metadata | screenshot | summary | product | branding | images | jsonld | json | feed (CSV or repeatable)",
      "items": {
        "type": "string"
      },
      "required": false,
      "source": "parser",
      "step_key": "format",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "array"
    },
    "formats": {
      "description": "Alias of format for multi-value (GAP-018)",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      ],
      "source": "catalog",
      "step_key": "formats",
      "surfaces": [
        "run_step",
        "exec"
      ]
    },
    "header": {
      "argv": "--header",
      "description": "Extra HTTP header `Name: value` (repeatable; cookies/auth)",
      "items": {
        "type": "string"
      },
      "required": false,
      "source": "parser",
      "step_key": "header",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "array"
    },
    "include_selector": {
      "argv": "--include-selector",
      "description": "CSS selectors to include (repeatable)",
      "items": {
        "type": "string"
      },
      "required": false,
      "source": "parser",
      "step_key": "include_selector",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "array"
    },
    "max_text_chars": {
      "argv": "--max-text-chars",
      "description": "Cap text/markdown/html chars (0 = XDG scrape_max_text_chars)",
      "required": false,
      "source": "parser",
      "step_key": "max_text_chars",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "integer"
    },
    "no_cache": {
      "argv": "--no-cache",
      "description": "Ignore the response cache and fetch from origin (default: XDG scrape_no_cache = false)",
      "required": false,
      "source": "parser",
      "step_key": "no_cache",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "boolean"
    },
    "only_main_content": {
      "argv": "--only-main-content",
      "description": "Prefer main/article content heuristics",
      "required": false,
      "source": "parser",
      "step_key": "only_main_content",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "boolean"
    },
    "question": {
      "argv": "--question",
      "description": "Question for format=json LLM extract",
      "required": false,
      "source": "parser",
      "step_key": "question",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "string"
    },
    "redact_pii": {
      "argv": "--redact-pii",
      "description": "Redact email/phone/card-like patterns in text/markdown",
      "required": false,
      "source": "parser",
      "step_key": "redact_pii",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "boolean"
    },
    "schema_json": {
      "argv": "--schema-json",
      "description": "JSON Schema file for format=json LLM extract",
      "required": false,
      "source": "parser",
      "step_key": "schema_json",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "string"
    },
    "select": {
      "argv": "--select",
      "description": "Project data fields (CSV); agent CLEAN STDOUT",
      "required": false,
      "source": "parser",
      "step_key": "select",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "string"
    },
    "url": {
      "argv": "<URL>",
      "description": "Absolute URL to fetch",
      "required": true,
      "source": "parser",
      "step_key": "url",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "string"
    },
    "wait_ms": {
      "argv": "--wait-ms",
      "default": 0,
      "description": "Browser engine: wait ms after navigation before capture (base waitFor)",
      "required": false,
      "source": "parser",
      "step_key": "wait_ms",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "integer"
    },
    "webhook_url": {
      "argv": "--webhook-url",
      "description": "Optional one-shot webhook POST of the result envelope data (127.0.0.1/operator URL)",
      "required": false,
      "source": "parser",
      "step_key": "webhook_url",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "string"
    },
    "with_content_hash": {
      "argv": "--with-content-hash",
      "description": "Include content_hash (sha256 of text/markdown)",
      "required": false,
      "source": "parser",
      "step_key": "with_content_hash",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "boolean"
    }
  },
  "required": [
    "url"
  ],
  "additionalProperties": false
}