{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/danilo-aguiar-br/browser-automation-cli/docs/schemas/keys.schema.json",
  "title": "keys command input",
  "type": "object",
  "description": "Press a keyboard key",
  "properties": {
    "include_snapshot": {
      "argv": "--include-snapshot",
      "description": "Attach slim a11y snapshot after the key press",
      "required": false,
      "source": "parser",
      "step_key": "include_snapshot",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "boolean"
    },
    "key": {
      "argv": "<KEY>",
      "description": "Key name to press (for example `Enter`, `Escape`, `Control+a`)",
      "required": true,
      "source": "parser",
      "step_key": "key",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "string"
    }
  },
  "required": [
    "key"
  ],
  "additionalProperties": false
}