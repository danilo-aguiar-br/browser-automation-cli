            "audio_codec": {
              "argv": "--audio-codec",
              "description": "Audio codec: copy | aac | opus | mp3 | … (default: copy intent)",
              "required": false,
              "source": "parser",
              "step_key": "audio_codec",
              "surfaces": [
                "argv"
              ],
              "type": "string"
            },
            "crf": {
              "argv": "--crf",
              "description": "CRF for re-encode (default: XDG video_default_crf)",
              "required": false,
              "source": "parser",
              "step_key": "crf",
              "surfaces": [
                "argv"
              ],
              "type": "integer"
            },
            "drop_audio": {
              "argv": "--drop-audio",
              "description": "Drop all audio tracks (opt-in; default keeps audio)",
              "required": false,
              "source": "parser",
              "step_key": "drop_audio",
              "surfaces": [
                "argv"
              ],
              "type": "boolean"
