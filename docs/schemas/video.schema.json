            "require_video": {
              "argv": "--require-video",
              "default": true,
              "description": "Fail closed unless body is a known video container magic (default)",
              "required": false,
              "source": "parser",
              "step_key": "require_video",
              "surfaces": [
                "argv"
              ],
              "type": "boolean"
            },
            "select": {
              "argv": "--select",
              "description": "Project envelope fields (CSV); aliases: format→container|container_out, bytes|size→size_bytes|bytes_out, path→path|path_out, duration→duration_secs",
              "required": false,
              "source": "parser",
              "step_key": "select",
              "surfaces": [
                "argv"
              ],
              "type": "string"
            },
            "url": {
              "argv": "<URL>",
              "description": "http(s) URL of the media file (not a site player page)",
              "required": true,
              "source": "parser",
              "step_key": "url",
              "surfaces": [
                "argv"
              ],
              "type": "string"
            }
          }
        },
        "info": {
          "description": "Probe container magic + streams (ffprobe when available; no media dump)",
          "properties": {
            "path": {
              "argv": "--path",
              "description": "Video file path (omit with `--stdin`)",
              "required": false,
              "source": "parser",
              "step_key": "path",
              "surfaces": [
                "argv"
