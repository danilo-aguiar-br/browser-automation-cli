              "surfaces": [
                "argv"
              ],
              "type": "boolean"
            },
            "out": {
              "argv": "--out",
              "description": "Output path (default under XDG cache)",
              "required": false,
              "source": "parser",
              "step_key": "out",
              "surfaces": [
                "argv"
              ],
              "type": "string"
            },
            "path": {
              "argv": "--path",
              "description": "Input video path (omit with `--stdin`)",
              "required": false,
              "source": "parser",
              "step_key": "path",
              "surfaces": [
                "argv"
              ],
              "type": "string"
            },
            "paths_file": {
              "argv": "--paths-file",
              "description": "Batch: one video path per line (`#` comments skipped). Mutually exclusive with `--path` and `--stdin`",
              "required": false,
              "source": "parser",
              "step_key": "paths_file",
              "surfaces": [
                "argv"
              ],
              "type": "string"
            },
            "select": {
              "argv": "--select",
              "description": "Project envelope fields (CSV); aliases: format→container|container_out, bytes|size→size_bytes|bytes_out, path→path|path_out, duration→duration_secs",
              "required": false,
              "source": "parser",
              "step_key": "select",
              "surfaces": [
                "argv"
              ],
              "type": "string"
            },
            "stdin": {
              "argv": "--stdin",
              "description": "Materialize stdin to a capped temp file",
              "required": false,
              "source": "parser",
              "step_key": "stdin",
