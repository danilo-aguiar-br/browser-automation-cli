            "stdin": {
              "argv": "--stdin",
              "description": "Materialize stdin to a capped temp file",
              "required": false,
              "source": "parser",
              "step_key": "stdin",
              "surfaces": [
                "argv"
              ],
              "type": "boolean"
            }
