{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/danilo-aguiar-br/browser-automation-cli/docs/schemas/video.schema.json",
  "title": "video command input",
  "type": "object",
  "description": "Local video pipeline one-shot (no Chrome): info/download/convert/to-mp3/trim/thumbnail/manifest",
  "properties": {
    "action": {
      "actions": {
        "convert": {
          "description": "Convert / remux container (path→path via optional ffmpeg; smart copy/re-encode)",
