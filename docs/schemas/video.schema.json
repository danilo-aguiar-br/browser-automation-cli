              "argv": "--allow-non-video",
              "description": "Allow non-video bodies (disables magic fail-closed)",
              "required": false,
              "source": "parser",
              "step_key": "allow_non_video",
              "surfaces": [
                "argv"
              ],
              "type": "boolean"
            },
            "max_bytes": {
              "argv": "--max-bytes",
              "description": "Max body bytes (default: XDG video_download_max_bytes)",
              "required": false,
              "source": "parser",
              "step_key": "max_bytes",
              "surfaces": [
                "argv"
              ],
              "type": "integer"
            },
            "out": {
              "argv": "--out",
              "description": "Output path (default under XDG cache)",
              "required": false,
              "source": "parser",
              "step_key": "out",
              "surfaces": [
                "argv"
              ],
              "type": "string"
