{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/danilo-aguiar-br/browser-automation-cli/docs/schemas/doctor.schema.json",
  "title": "doctor command input",
  "type": "object",
  "description": "Diagnose Chrome install and one-shot readiness",
  "properties": {
    "fingerprint": {
      "argv": "--fingerprint",
      "description": "Compare identity signals (webdriver, platform vs UA, screen vs viewport)",
      "required": false,
      "source": "parser",
      "step_key": "fingerprint",
      "surfaces": [
        "argv"
      ],
      "type": "boolean"
    },
    "fix": {
      "argv": "--fix",
      "description": "Attach a suggested repair command to each failing check",
      "required": false,
      "source": "parser",
      "step_key": "fix",
      "surfaces": [
        "argv"
      ],
      "type": "boolean"
    },
    "json": {
      "description": "Global envelope flag --json (not a local doctor flag)",
      "source": "catalog",
      "step_key": "json",
      "surfaces": [],
      "type": "boolean"
    },
    "offline": {
      "argv": "--offline",
      "description": "Skip network probes and record `offline` mode in the report",
      "required": false,
      "source": "parser",
      "step_key": "offline",
      "surfaces": [
        "argv"
      ],
      "type": "boolean"
    },
    "quick": {
      "argv": "--quick",
      "description": "Skip the Chrome launch probe (fastest readiness signal)",
      "required": false,
      "source": "parser",
      "step_key": "quick",
      "surfaces": [
        "argv"
      ],
      "type": "boolean"
    }
  },
  "required": [],
  "additionalProperties": false
}