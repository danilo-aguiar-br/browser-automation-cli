{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/danilo-aguiar-br/browser-automation-cli/docs/schemas/resize.schema.json",
  "title": "resize command input",
  "type": "object",
  "description": "Resize page viewport",
  "properties": {
    "height": {
      "argv": "--height",
      "description": "Viewport height in CSS pixels",
      "required": true,
      "source": "parser",
      "step_key": "height",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "integer"
    },
    "mobile": {
      "argv": "--mobile",
      "description": "Enable mobile metrics emulation",
      "required": false,
      "source": "parser",
      "step_key": "mobile",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "boolean"
    },
    "scale": {
      "argv": "--scale",
      "default": 1.0,
      "description": "Device pixel ratio",
      "required": false,
      "source": "parser",
      "step_key": "scale",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "number"
    },
    "screen": {
      "argv": "--screen",
      "description": "Screen size `WxH`. Defaults to the viewport so screen cannot stay 800x600",
      "required": false,
      "source": "parser",
      "step_key": "screen",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "string"
    },
    "width": {
      "argv": "--width",
      "description": "Viewport width in CSS pixels",
      "required": true,
      "source": "parser",
      "step_key": "width",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "integer"
    }
  },
  "required": [
    "width",
    "height"
  ],
  "additionalProperties": false
}