{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/danilo-aguiar-br/browser-automation-cli/docs/schemas/print-pdf.schema.json",
  "title": "print-pdf command input",
  "type": "object",
  "description": "Print current page to PDF via CDP Page.printToPDF (one-shot)",
  "properties": {
    "path": {
      "argv": "--path",
      "description": "Output path for the PDF artifact",
      "required": false,
      "source": "parser",
      "step_key": "path",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "string"
    },
    "url": {
      "argv": "--url",
      "description": "Optional URL to navigate before printing (one-shot)",
      "required": false,
      "source": "parser",
      "step_key": "url",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "string"
    }
  },
  "required": [],
  "additionalProperties": false
}