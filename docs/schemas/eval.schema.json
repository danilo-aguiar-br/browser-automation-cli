{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/danilo-aguiar-br/browser-automation-cli/docs/schemas/eval.schema.json",
  "title": "eval command input",
  "type": "object",
  "description": "Evaluate JavaScript (expression or function declaration)",
  "properties": {
    "args": {
      "argv": "--args",
      "description": "Snapshot uids (@eN) passed as function args (JSON array of strings)",
      "required": false,
      "source": "parser",
      "step_key": "args",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "string"
    },
    "dialog_action": {
      "argv": "--dialog-action",
      "description": "accept | dismiss | prompt response text (default accept)",
      "required": false,
      "source": "parser",
      "step_key": "dialog_action",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "string"
    },
    "expression": {
      "argv": "<EXPRESSION>",
      "description": "JS expression or function declaration `() => ...`",
      "required": true,
      "source": "parser",
      "step_key": "expression",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "string"
    },
    "file_path": {
      "argv": "--file-path",
      "description": "Write evaluate result JSON to this path",
      "required": false,
      "source": "parser",
      "step_key": "file_path",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "string"
    },
    "service_worker_id": {
      "argv": "--service-worker-id",
      "description": "Evaluate inside an extension service worker target (tool-ref serviceWorkerId)",
      "required": false,
      "source": "parser",
      "step_key": "service_worker_id",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "string"
    },
    "typed": {
      "argv": "--typed",
      "description": "Return the deserialized structure under `data.value` plus the page-reported `data.value_type` instead of the legacy `data.result` (GAP-035)",
      "required": false,
      "source": "parser",
      "step_key": "typed",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "boolean"
    }
  },
  "required": [
    "expression"
  ],
  "additionalProperties": false
}