{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/danilo-aguiar-br/browser-automation-cli/docs/schemas/crawl.schema.json",
  "title": "crawl command input",
  "type": "object",
  "description": "Crawl from a seed URL (HTTP BFS or browser, one-shot)",
  "properties": {
    "dedup_key": {
      "argv": "--dedup-key",
      "description": "Deduplicate pages by field",
      "required": false,
      "source": "parser",
      "step_key": "dedup_key",
      "surfaces": [
        "argv"
      ],
      "type": "string"
    },
    "dedup_similar": {
      "argv": "--dedup-similar",
      "description": "Collapse near-duplicate pages by content similarity; threshold is XDG scrape_dedup_similar_distance (default: XDG scrape_dedup_similar = false)",
      "required": false,
      "source": "parser",
      "step_key": "dedup_similar",
      "surfaces": [
        "argv"
      ],
      "type": "boolean"
    },
    "dry_run": {
      "argv": "--dry-run",
      "description": "Resolve and print the effective plan without fetching anything",
      "required": false,
      "source": "parser",
      "step_key": "dry_run",
      "surfaces": [
        "argv"
      ],
      "type": "boolean"
    },
    "engine": {
      "argv": "--engine",
      "default": "http",
      "description": "http (default) or browser (GAP-010)",
      "required": false,
      "source": "parser",
      "step_key": "engine",
      "surfaces": [
        "argv"
      ],
      "type": "string"
    },
    "exclude_path": {
      "argv": "--exclude-path",
      "description": "Exclude path prefixes (repeatable)",
      "items": {
        "type": "string"
      },
      "required": false,
      "source": "parser",
      "step_key": "exclude_path",
      "surfaces": [
        "argv"
      ],
      "type": "array"
    },
    "exclude_regex": {
      "argv": "--exclude-regex",
      "description": "Exclude paths/URLs matching this regex (repeatable)",
      "items": {
        "type": "string"
      },
      "required": false,
      "source": "parser",
      "step_key": "exclude_regex",
      "surfaces": [
        "argv"
      ],
      "type": "array"
    },
    "exclude_selector": {
      "argv": "--exclude-selector",
      "description": "CSS exclude selectors",
      "items": {
        "type": "string"
      },
      "required": false,
      "source": "parser",
      "step_key": "exclude_selector",
      "surfaces": [
        "argv"
      ],
      "type": "array"
    },
    "filter": {
      "argv": "--filter",
      "description": "Filter pages: key=value AND expressions",
      "required": false,
      "source": "parser",
      "step_key": "filter",
      "surfaces": [
        "argv"
      ],
      "type": "string"
    },
    "follow_rel_next": {
      "argv": "--follow-rel-next",
      "description": "Follow `rel=next` pagination links (default: XDG scrape_follow_rel_next = false)",
      "required": false,
      "source": "parser",
      "step_key": "follow_rel_next",
      "surfaces": [
        "argv"
      ],
      "type": "boolean"
    },
    "format": {
      "argv": "--format",
      "default": "text",
      "description": "Output format(s) applied to every page (CSV or repeatable)",
      "items": {
        "type": "string"
      },
      "required": false,
      "source": "parser",
      "step_key": "format",
      "surfaces": [
        "argv"
      ],
      "type": "array"
    },
    "ignore_query_params": {
      "argv": "--ignore-query-params",
      "description": "Collapse query params when deduping URLs",
      "required": false,
      "source": "parser",
      "step_key": "ignore_query_params",
      "surfaces": [
        "argv"
      ],
      "type": "boolean"
    },
    "include_path": {
      "argv": "--include-path",
      "description": "Include only path prefixes (repeatable)",
      "items": {
        "type": "string"
      },
      "required": false,
      "source": "parser",
      "step_key": "include_path",
      "surfaces": [
        "argv"
      ],
      "type": "array"
    },
    "include_regex": {
      "argv": "--include-regex",
      "description": "Include paths/URLs matching this regex (repeatable)",
      "items": {
        "type": "string"
      },
      "required": false,
      "source": "parser",
      "step_key": "include_regex",
      "surfaces": [
        "argv"
      ],
      "type": "array"
    },
    "include_selector": {
      "argv": "--include-selector",
      "description": "CSS include selectors",
      "items": {
        "type": "string"
      },
      "required": false,
      "source": "parser",
      "step_key": "include_selector",
      "surfaces": [
        "argv"
      ],
      "type": "array"
    },
    "limit": {
      "argv": "--limit",
      "default": 20,
      "description": "Maximum number of pages to fetch",
      "required": false,
      "source": "parser",
      "step_key": "limit",
      "surfaces": [
        "argv"
      ],
      "type": "integer"
    },
    "max_depth": {
      "argv": "--max-depth",
      "default": 2,
      "description": "Maximum link depth from the seed",
      "required": false,
      "source": "parser",
      "step_key": "max_depth",
      "surfaces": [
        "argv"
      ],
      "type": "integer"
    },
    "max_pages": {
      "description": "Alias of limit",
      "minimum": 1,
      "source": "catalog",
      "step_key": "max_pages",
      "surfaces": [],
      "type": "integer"
    },
    "max_text_chars": {
      "argv": "--max-text-chars",
      "description": "Cap text/markdown/html chars (0 = XDG default)",
      "required": false,
      "source": "parser",
      "step_key": "max_text_chars",
      "surfaces": [
        "argv"
      ],
      "type": "integer"
    },
    "no_same_host": {
      "argv": "--no-same-host",
      "description": "Follow links off the seed host, disabling `--same-host`",
      "required": false,
      "source": "parser",
      "step_key": "no_same_host",
      "surfaces": [
        "argv"
      ],
      "type": "boolean"
    },
    "only_main_content": {
      "argv": "--only-main-content",
      "description": "Prefer main/article content heuristics",
      "required": false,
      "source": "parser",
      "step_key": "only_main_content",
      "surfaces": [
        "argv"
      ],
      "type": "boolean"
    },
    "output_mode": {
      "argv": "--output-mode",
      "default": "json",
      "description": "json (default), ndjson, csv, or llms-txt (site summary for models)",
      "required": false,
      "source": "parser",
      "step_key": "output_mode",
      "surfaces": [
        "argv"
      ],
      "type": "string"
    },
    "redact_pii": {
      "argv": "--redact-pii",
      "description": "Redact PII",
      "required": false,
      "source": "parser",
      "step_key": "redact_pii",
      "surfaces": [
        "argv"
      ],
      "type": "boolean"
    },
    "same_host": {
      "argv": "--same-host",
      "default": true,
      "description": "Stay on seed host (default)",
      "required": false,
      "source": "parser",
      "step_key": "same_host",
      "surfaces": [
        "argv"
      ],
      "type": "boolean"
    },
    "select": {
      "argv": "--select",
      "description": "Project data fields (CSV)",
      "required": false,
      "source": "parser",
      "step_key": "select",
      "surfaces": [
        "argv"
      ],
      "type": "string"
    },
    "sitemap_only": {
      "argv": "--sitemap-only",
      "description": "Fetch only the sitemap.xml frontier (no HTML link BFS)",
      "required": false,
      "source": "parser",
      "step_key": "sitemap_only",
      "surfaces": [
        "argv"
      ],
      "type": "boolean"
    },
    "sort": {
      "argv": "--sort",
      "description": "Sort pages by field",
      "required": false,
      "source": "parser",
      "step_key": "sort",
      "surfaces": [
        "argv"
      ],
      "type": "string"
    },
    "url": {
      "argv": "<URL>",
      "description": "Seed URL the breadth-first crawl starts from",
      "required": true,
      "source": "parser",
      "step_key": "url",
      "surfaces": [
        "argv"
      ],
      "type": "string"
    },
    "use_sitemap": {
      "argv": "--use-sitemap",
      "description": "Seed frontier from sitemap.xml (default: XDG scrape_use_sitemap)",
      "required": false,
      "source": "parser",
      "step_key": "use_sitemap",
      "surfaces": [
        "argv"
      ],
      "type": "boolean"
    },
    "webhook_url": {
      "argv": "--webhook-url",
      "description": "Optional one-shot webhook POST of the collection envelope (operator URL)",
      "required": false,
      "source": "parser",
      "step_key": "webhook_url",
      "surfaces": [
        "argv"
      ],
      "type": "string"
    },
    "with_content_hash": {
      "argv": "--with-content-hash",
      "description": "Include content_hash",
      "required": false,
      "source": "parser",
      "step_key": "with_content_hash",
      "surfaces": [
        "argv"
      ],
      "type": "boolean"
    }
  },
  "required": [
    "url"
  ],
  "additionalProperties": false
}