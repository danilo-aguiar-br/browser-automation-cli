{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/danilo-aguiar-br/browser-automation-cli/docs/schemas/completions.schema.json",
  "title": "completions command input",
  "type": "object",
  "description": "Generate shell completions (path-level, no Chrome)",
  "properties": {
    "shell": {
      "argv": "<SHELL>",
      "description": "Shell dialect to generate completions for",
      "enum": [
        "bash",
        "zsh",
        "fish",
        "elvish",
        "powershell"
      ],
      "required": true,
      "source": "parser",
      "step_key": "shell",
      "surfaces": [
        "argv"
      ],
      "type": "string"
    }
  },
  "required": [
    "shell"
  ],
  "additionalProperties": false
}