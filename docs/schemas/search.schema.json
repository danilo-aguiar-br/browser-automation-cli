{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/danilo-aguiar-br/browser-automation-cli/docs/schemas/search.schema.json",
  "title": "search command input",
  "type": "object",
  "description": "Local search (HTTP SERP links or URL map)",
  "properties": {
    "limit": {
      "argv": "--limit",
      "default": 10,
      "description": "Maximum number of results to return",
      "required": false,
      "source": "parser",
      "step_key": "limit",
      "surfaces": [
        "argv"
      ],
      "type": "integer"
    },
    "query": {
      "argv": "<QUERY>",
      "description": "Search terms sent to the configured HTML endpoint",
      "required": true,
      "source": "parser",
      "step_key": "query",
      "surfaces": [
        "argv"
      ],
      "type": "string"
    }
  },
  "required": [
    "query"
  ],
  "additionalProperties": false
}