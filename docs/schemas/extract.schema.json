{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/danilo-aguiar-br/browser-automation-cli/docs/schemas/extract.schema.json",
  "title": "extract command input",
  "type": "object",
  "description": "Extract text/attribute from a target, or LLM extract with --llm",
  "properties": {
    "attr": {
      "argv": "--attr",
      "description": "Read this attribute instead of the element text",
      "required": false,
      "source": "parser",
      "step_key": "attr",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "string"
    },
    "llm": {
      "argv": "--llm",
      "description": "Opt-in LLM HTTP extract (requires XDG openrouter_api_key)",
      "required": false,
      "source": "parser",
      "step_key": "llm",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "boolean"
    },
    "question": {
      "argv": "--question",
      "description": "Question for LLM extract",
      "required": false,
      "source": "parser",
      "step_key": "question",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "string"
    },
    "schema_json": {
      "argv": "--schema-json",
      "description": "Path to JSON schema file for structured LLM extract",
      "required": false,
      "source": "parser",
      "step_key": "schema_json",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "string"
    },
    "target": {
      "argv": "<TARGET>",
      "description": "Selector, @eN ref, about:blank target, or http(s) URL for LLM/text path",
      "required": true,
      "source": "parser",
      "step_key": "target",
      "surfaces": [
        "argv",
        "run_step",
        "exec"
      ],
      "type": "string"
    }
  },
  "required": [
    "target"
  ],
  "additionalProperties": false
}